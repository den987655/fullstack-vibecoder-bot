@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.pumltitle Container diagram for Console Gemini Chat (Level 2)Person(user, "User / Developer", "Interacts via terminal.")System_Ext(geminiAPI, "Google Gemini API", "Google AI Studio Cloud API providing LLM inference (gemini-3.5-flash-lite).")System_Boundary(chatBoundary, "Console Gemini Chat System") {    Container(terminal, "OS Terminal", "CMD / PowerShell / Bash", "Captures keyboard input (stdin) and renders text output (stdout).")    Container(cliApp, "Node.js CLI Application", "Node.js v24, Pure JavaScript", "Reads input lines, manages dialog memory, dispatches full correspondence to LLM, and prints answers.")    ContainerDb(memoryStore, "Memory Storage", "JSON File (memory.json)", "Persists accumulated multi-turn conversation correspondence on disk.")    ContainerDb(envFile, "Environment Configuration", ".env / 02-lesson/frontend/.env", "Stores API keys and configuration parameters.")}Rel(user, terminal, "Types text & views output", "Keyboard / Display")Rel(terminal, cliApp, "Streams input & output", "process.stdin / process.stdout")Rel(cliApp, memoryStore, "Loads & persists correspondence history", "fs.readFileSync / fs.writeFileSync")Rel(cliApp, envFile, "Loads API key & config on startup", "fs.readFileSync")Rel(cliApp, geminiAPI, "Sends full conversation history (generateContent)", "HTTPS / JSON (fetch)")SHOW_LEGEND()@enduml