@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.pumltitle System Context diagram for Console Gemini Chat with Memory (Level 1)Person(user, "User / Developer", "Interacts with the chat application via OS terminal / command prompt.")System(chatSystem, "Console Gemini Chat", "CLI application that maintains persistent dialogue memory on disk, passes full conversation history to Google Gemini LLM, and outputs answers to the console.")System_Ext(geminiAPI, "Google Gemini API", "Google AI Studio Cloud API providing multi-turn conversational LLM inference (gemini-3.5-flash-lite).")Rel(user, chatSystem, "Enters prompts & reads contextual answers", "CLI / Terminal (STDIN/STDOUT)")Rel(chatSystem, geminiAPI, "Sends accumulated dialogue & receives completion", "HTTPS / JSON / TLS 443")SHOW_LEGEND()@enduml