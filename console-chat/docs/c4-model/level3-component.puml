@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.pumltitle Component diagram for Node.js CLI Application (Level 3)Container_Ext(terminalIO, "OS Terminal I/O", "process.stdin / process.stdout", "Streams character data to/from user.")Container_Ext(geminiAPI, "Google Gemini API", "External Cloud Service", "Provides LLM completions.")Container_Boundary(cliApp, "Node.js CLI Application") {    Component(chatJs, "Chat Line Processor", "chat.js", "Initializes readline interface, listens to 'line' events, and invokes adapter.")    Component(geminiAdapter, "GeminiAdapter", "geminiAdapter.js", "Encapsulates LLM communication, request building, and response parsing.")    Component(envLoader, "loadEnv", "geminiAdapter.js", "Finds and parses .env files from project paths without external dependencies.")    Component(fetchClient, "Native Fetch Client", "node:fetch / V8 runtime", "Performs asynchronous HTTPS POST requests to Google API.")    Rel(chatJs, geminiAdapter, "Calls askGemini(line)", "JavaScript async function")    Rel(geminiAdapter, envLoader, "Retrieves API key & model settings", "In-memory")    Rel(geminiAdapter, fetchClient, "Dispatches HTTP POST with payload", "JSON / fetch")}Rel(terminalIO, chatJs, "Emits 'line' on Enter key", "readline EventEmitter")Rel(chatJs, terminalIO, "Prints response text", "console.log / stdout")Rel(fetchClient, geminiAPI, "POST /v1beta/models/...:generateContent", "HTTPS / JSON")SHOW_LEGEND()@enduml