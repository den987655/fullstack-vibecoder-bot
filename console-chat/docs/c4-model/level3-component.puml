@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.pumltitle Component diagram for Node.js CLI Application with Memory (Level 3)Container_Ext(terminalIO, "OS Terminal I/O", "process.stdin / process.stdout", "Streams character data to/from user.")Container_Ext(geminiAPI, "Google Gemini API", "External Cloud Service", "Provides multi-turn conversational LLM completions.")ContainerDb_Ext(diskStorage, "Disk File System", "memory.json", "Persists conversation history across sessions.")Container_Boundary(cliApp, "Node.js CLI Application") {    Component(chatJs, "Chat Line Processor", "chat.js", "Listens to 'line' events, coordinates memory updates, and drives conversation loop.")    Component(memoryModule, "Memory Manager", "memory.js", "Accumulates dialog turns and handles reading/writing to memory.json.")    Component(geminiAdapter, "GeminiAdapter", "geminiAdapter.js", "Packages accumulated correspondence into Gemini format and parses completions.")    Component(envLoader, "loadEnv", "geminiAdapter.js", "Finds and parses .env files from project paths without external dependencies.")    Component(fetchClient, "Native Fetch Client", "node:fetch / V8 runtime", "Performs asynchronous HTTPS POST requests to Google API.")    Rel(chatJs, memoryModule, "Appends user turn & retrieves full history", "JavaScript method calls")    Rel(chatJs, geminiAdapter, "Calls askGemini(fullHistory)", "JavaScript async call")    Rel(chatJs, memoryModule, "Appends model response turn", "JavaScript method calls")    Rel(memoryModule, diskStorage, "Reads and writes JSON history", "fs.readFileSync / fs.writeFileSync")    Rel(geminiAdapter, envLoader, "Retrieves API key & model settings", "In-memory")    Rel(geminiAdapter, fetchClient, "Dispatches HTTP POST with full contents", "JSON / fetch")}Rel(terminalIO, chatJs, "Emits 'line' on Enter key", "readline EventEmitter")Rel(chatJs, terminalIO, "Prints response text", "console.log / stdout")Rel(fetchClient, geminiAPI, "POST /v1beta/models/...:generateContent", "HTTPS / JSON")SHOW_LEGEND()@enduml