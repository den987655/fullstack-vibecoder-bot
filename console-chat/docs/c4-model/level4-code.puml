@startumltitle Code Execution / Sequence diagram for Console Gemini Chat (Level 4)autonumberskinparam responseMessageBelowArrow trueskinparam BoxPadding 10skinparam ParticipantPadding 10actor User as "👤 User"box "chat.js (CLI Presentation Layer)" #LightCyan    participant Readline as "readline.Interface\n(rl)"    participant LineHandler as "Line Processor\nrl.on('line')"end boxbox "geminiAdapter.js (Infrastructure / Adapter Layer)" #LightYellow    participant AskGemini as "askGemini(prompt)"    participant GeminiClass as "GeminiAdapter"    participant LoadEnv as "loadEnv()"    participant Fetch as "fetch(url, options)"end boxbox "External Cloud" #Lavender    participant GeminiAPI as "Google Gemini API\n:generateContent"end boxUser -> Readline: Enters text + EnterReadline -> LineHandler: emit('line', line)activate LineHandlerLineHandler -> AskGemini: askGemini(line)activate AskGeminiAskGemini -> GeminiClass: adapter.ask(line)activate GeminiClassGeminiClass -> LoadEnv: getCredentials()activate LoadEnvLoadEnv --> GeminiClass: { apiKey, model }deactivate LoadEnvGeminiClass -> GeminiClass: Build JSON Payload\n{ contents: [{ parts: [{ text }] }] }GeminiClass -> Fetch: POST https://generativelanguage.googleapis.com/...activate FetchFetch -> GeminiAPI: HTTP POST (x-goog-api-key)activate GeminiAPINote over GeminiAPI: Inference execution\n(gemini-3.5-flash-lite)GeminiAPI --> Fetch: HTTP 200 OK (candidates JSON)deactivate GeminiAPIFetch --> GeminiClass: response.json()deactivate FetchGeminiClass -> GeminiClass: Extract candidates[0].content.parts[0].textGeminiClass --> AskGemini: return textdeactivate GeminiClassAskGemini --> LineHandler: return textdeactivate AskGeminiLineHandler -> User: console.log(answer)LineHandler -> Readline: rl.prompt() ('> ')deactivate LineHandler@enduml