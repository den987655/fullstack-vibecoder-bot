@startumltitle Code Execution Sequence for Multi-turn Memory Chat (Level 4)autonumberskinparam responseMessageBelowArrow trueskinparam BoxPadding 10skinparam ParticipantPadding 10actor User as "👤 User"box "chat.js (CLI Presentation Layer)" #LightCyan    participant Readline as "readline.Interface\n(rl)"    participant LineHandler as "Line Processor\nrl.on('line')"end boxbox "memory.js (Storage & History Layer)" #LightGreen    participant Memory as "Memory\n(memory.js)"    database DiskFile as "memory.json\n(on disk)"end boxbox "geminiAdapter.js (Infrastructure / Adapter Layer)" #LightYellow    participant AskGemini as "askGemini(history)"    participant GeminiClass as "GeminiAdapter"    participant Fetch as "fetch(url, options)"end boxbox "External Cloud" #Lavender    participant GeminiAPI as "Google Gemini API\n:generateContent"end boxUser -> Readline: Enters message + EnterReadline -> LineHandler: emit('line', line)activate LineHandlerLineHandler -> Memory: addUserMessage(line)activate MemoryMemory -> Memory: append { role: 'user', parts: [{ text }] }Memory -> DiskFile: fs.writeFileSync(memory.json)deactivate MemoryLineHandler -> Memory: getHistory()activate MemoryMemory --> LineHandler: Return full accumulated contents [...]deactivate MemoryLineHandler -> AskGemini: askGemini(fullHistory)activate AskGeminiAskGemini -> GeminiClass: adapter.ask(fullHistory)activate GeminiClassGeminiClass -> Fetch: POST /v1beta/models/...:generateContent\n{ contents: fullHistory }activate FetchFetch -> GeminiAPI: HTTPS POST (x-goog-api-key)activate GeminiAPINote over GeminiAPI: Multi-turn LLM inference\n(gemini-3.5-flash-lite)GeminiAPI --> Fetch: HTTP 200 OK (candidates JSON)deactivate GeminiAPIFetch --> GeminiClass: response.json()deactivate FetchGeminiClass -> GeminiClass: Extract candidates[0].content.parts[0].textGeminiClass --> AskGemini: return replydeactivate GeminiClassAskGemini --> LineHandler: return replydeactivate AskGeminiLineHandler -> Memory: addModelResponse(reply)activate MemoryMemory -> Memory: append { role: 'model', parts: [{ text }] }Memory -> DiskFile: fs.writeFileSync(memory.json)deactivate MemoryLineHandler -> User: console.log(reply)LineHandler -> Readline: rl.prompt() ('> ')deactivate LineHandler@enduml