@startuml c4-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' Белый фон, строгие ортогональные линии (вместо длинной "лестницы")
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100

HIDE_STEREOTYPE()

System_Ext(telegram, "Telegram", "External System")

Container_Boundary(server, "Bot Server") {
    Component(app, "Fastify App", "", "Creates server & routes")
    Component(webhook, "Telegram Webhook Route", "", "Accepts webhook payloads")
    Component(usecase, "Handle Message", "", "Processes logic and math")
    
    Component(sender, "Telegram Sender", "", "Posts replies to API")
    Component(provider, "Rate Provider", "", "Fetches foreign rates")
}

System_Ext(ff, "Frankfurter API", "External System")

' Принудительная горизонтальная (left-to-right) композиция пайплайна
app -[hidden]D-> webhook
telegram -[hidden]R-> webhook
webhook -[hidden]R-> usecase
usecase -[hidden]R-> sender
sender -[hidden]D-> provider
provider -[hidden]R-> ff

Rel_D(app, webhook, "Registers route")
Rel_R(telegram, webhook, "POST /webhook/telegram")
Rel_R(webhook, usecase, "Handle message")

' Ветвление (Вилка) от UseCase
Rel_R(usecase, provider, "Get exchange rate")
Rel_R(usecase, sender, "Send message")

Rel_R(provider, ff, "HTTP / JSON")
Rel_U(sender, telegram, "Telegram Bot API")
@enduml
