@startuml c4-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Белый фон, строгие ортогональные линии
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100

HIDE_STEREOTYPE()

System_Ext(telegram, "Telegram", "External System")

System_Boundary(sys, "Currency Rate Bot") {
    Container(setup_script, "Webhook Setup Script", "Node.js", "Registers webhook URL")
    Container(bot_server, "Bot Server", "Node.js / Fastify", "Handles incoming logic")
}

System_Ext(ff, "Frankfurter API", "External System")

' Контролируем горизонтальную компоновку (слева направо)
setup_script -[hidden]D-> bot_server
telegram -[hidden]R-> bot_server
bot_server -[hidden]R-> ff

Rel_L(setup_script, telegram, "Register webhook")
Rel_R(telegram, bot_server, "Webhook POST")
Rel_R(bot_server, ff, "Get exchange rate")
Rel_L(bot_server, telegram, "Send reply")
@enduml
