@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context diagram for Fullstack Vibecoder Bot

Person(user, "Telegram User", "A user of the bot through the Telegram app")

System(botSystem, "Telegram Bot System", "Provides the core business logic, webhooks, and connects to external APIs. Built with Node.js & Fastify using Clean Architecture.")

System_Ext(telegramAPI, "Telegram API", "The official Telegram Bot API used for receiving webhooks and sending messages.")

Rel(user, telegramAPI, "Interacts with", "Telegram Client")
Rel(telegramAPI, botSystem, "Forwards updates via Webhook", "HTTPS/JSON")
Rel(botSystem, telegramAPI, "Sends messages and API requests", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
