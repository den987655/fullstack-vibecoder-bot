@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.pumltitle Container diagram for Fullstack Vibecoder BotPerson(user, "Telegram User", "A user of the bot through the Telegram app")System_Ext(telegramAPI, "Telegram API", "The official Telegram Bot API used for receiving webhooks and sending messages.")System_Ext(frankfurterAPI, "Frankfurter API", "Open source API for current and historical foreign exchange rates published by ECB.")System_Boundary(botSystem, "Telegram Bot System") {    Container(webApp, "Web Application", "Node.js, Fastify", "Handles incoming webhooks, contains core business logic for processing commands, and interacts with external APIs.")}Rel(user, telegramAPI, "Interacts with", "Telegram Client")Rel(telegramAPI, webApp, "Forwards updates via Webhook", "HTTPS/JSON")Rel(webApp, telegramAPI, "Sends responses and messages", "HTTPS/JSON")Rel(webApp, frankfurterAPI, "Fetches exchange rates", "HTTPS/JSON")SHOW_LEGEND()@enduml