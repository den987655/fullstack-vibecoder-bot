@startuml!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.pumltitle Component diagram for the Web Application (Node.js Bot)Container_Ext(telegramAPI, "Telegram API", "External Service", "Connects users with the bot.")Container_Ext(frankfurterAPI, "Frankfurter API", "External API", "Provides currency exchange rates.")Container_Boundary(webApp, "Web Application") {    Component(fastifyApp, "FastifyApp", "Infrastructure / Server", "Initializes the Fastify server, registers routes and listens on the configured port.")    Component(webhookController, "WebhookController", "Presentation", "Receives webhooks, extracts payload and passes data to Use Cases.")    Component(handleMgsUseCase, "HandleMessageUseCase", "Application", "Core business logic. Parses messages, calculates conversions, formats output.")    Component(telegramSender, "TelegramSender", "Infrastructure / Bot", "Wraps HTTP requests to send messages/callbacks back to Telegram.")    Component(frankfurterProvider, "FrankfurterApi", "Infrastructure / Provider", "Fetches live currency rates from the external API.")    Component(envConfig, "EnvConfig", "Config", "Loads .env variables and provides configuration options.")    Rel(fastifyApp, webhookController, "Registers route", "/webhook/telegram")    Rel(fastifyApp, envConfig, "Reads config from")        Rel(webhookController, handleMgsUseCase, "Calls execute / handleCallback", "Direct Import")        Rel(handleMgsUseCase, frankfurterProvider, "Gets latest rates via", "Direct Import")    Rel(handleMgsUseCase, telegramSender, "Sends responses via", "Direct Import")}Rel(telegramAPI, fastifyApp, "Sends webhook requests to", "HTTPS/JSON")Rel(telegramSender, telegramAPI, "Makes API calls to", "HTTPS/JSON")Rel(frankfurterProvider, frankfurterAPI, "Fetches rates from", "HTTPS/JSON")SHOW_LEGEND()@enduml