@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Белый фон, строгие ортогональные линии, просторные отступы для читаемости
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100

HIDE_STEREOTYPE()

Person(user, "Telegram User", "User")
System_Ext(telegram, "Telegram", "External System")
System(bot, "Currency Rate Bot", "Main Application")
System_Ext(ff, "Frankfurter API", "External System")

' Жесткая горизонтальная компоновка слева направо
user -[hidden]R-> telegram
telegram -[hidden]R-> bot
bot -[hidden]R-> ff

Rel_R(user, telegram, "Uses Telegram bot")
Rel_R(telegram, bot, "Telegram webhook")
Rel_R(bot, ff, "Requests exchange rate")

Rel_L(ff, bot, "Returns exchange rate")
Rel_L(bot, telegram, "Sends reply")
Rel_L(telegram, user, "Delivers message")
@enduml
